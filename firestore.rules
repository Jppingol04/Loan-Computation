rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * IFRS 9 LOAN ACCRUAL ENGINE - SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict User-Ownership model. Access to any loan-related data 
     * is strictly restricted to the user who created the loan. 
     * 
     * DATA STRUCTURE:
     * The database is organized around a top-level /loans/ collection. All related 
     * entities (Amortization Schedules, Interest Rate Changes, Journal Entries, 
     * and Audit Trails) are stored as subcollections under specific loan documents.
     * 
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: To maximize performance and simplify rules, the owner's 
     *    UID (userId or loanOwnerUserId) is denormalized into every single document. 
     *    This allows rules to verify access using the document's own data without 
     *    expensive get() calls to parent documents.
     * 2. Relational Integrity: During creation, the rules enforce that the internal 
     *    ownership field matches the authenticated user's UID.
     * 3. Immutability: Ownership fields are marked as immutable; once a loan or record 
     *    is created, its ownership cannot be transferred to another user.
     * 4. Prototyping Flexibility: While access control is strictly enforced, the 
     *    internal schema (strings, numbers, dates) is not validated to allow for 
     *    rapid UI and logic iteration.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the provided UID matches the authenticated user's UID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Combined check for update/delete: ensures document exists and user owns it. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** 
     * Validates that the owner ID in the new data remains unchanged. 
     * Used to prevent users from 'transferring' documents by changing IDs.
     */
    function isOwnerImmutable(userIdField) {
      return request.resource.data[userIdField] == resource.data[userIdField];
    }

    // --- COLLECTION RULES ---

    /**
     * @description Primary loan configuration and metadata.
     * @path /loans/{loanId}
     * @allow (create) Signed-in user where userId field matches their UID.
     * @deny (get) If the user is not the owner of the loan.
     * @principle Enforces document ownership for writes and private read access.
     */
    match /loans/{loanId} {
      allow get, list: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId) && isOwnerImmutable('userId');
      allow delete: if isExistingOwner(resource.data.userId);

      /**
       * @description Individual monthly periods for a loan's amortization schedule.
       * @path /loans/{loanId}/schedule/{periodNumber}
       * @allow (list) Owner of the parent loan (via denormalized userId field).
       * @deny (update) If attempt is made to change the owner ID.
       * @principle Authorization Independence via denormalization.
       */
      match /schedule/{periodNumber} {
        allow get, list: if isOwner(resource.data.userId);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId) && isOwnerImmutable('userId');
        allow delete: if isExistingOwner(resource.data.userId);
      }

      /**
       * @description Log of interest rate changes for prospective recalculations.
       * @path /loans/{loanId}/interestRateChanges/{changeId}
       * @allow (create) Signed-in user where loanOwnerUserId field matches their UID.
       * @deny (delete) If the user is not the owner of the loan.
       * @principle Explicit distinction between the actor (changedBy) and owner (loanOwnerUserId).
       */
      match /interestRateChanges/{changeId} {
        allow get, list: if isOwner(resource.data.loanOwnerUserId);
        allow create: if isSignedIn() && request.resource.data.loanOwnerUserId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.loanOwnerUserId) && isOwnerImmutable('loanOwnerUserId');
        allow delete: if isExistingOwner(resource.data.loanOwnerUserId);
      }

      /**
       * @description Financial journal entries generated for accounting integrations.
       * @path /loans/{loanId}/journalEntries/{entryId}
       * @allow (get) Owner of the loan.
       * @deny (create) If userId in payload does not match the creator's UID.
       * @principle Secure list operations using denormalized ownership fields.
       */
      match /journalEntries/{entryId} {
        allow get, list: if isOwner(resource.data.userId);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId) && isOwnerImmutable('userId');
        allow delete: if isExistingOwner(resource.data.userId);
      }

      /**
       * @description Immutable audit logs for actions performed on the loan.
       * @path /loans/{loanId}/auditTrail/{entryId}
       * @allow (list) Owner of the loan to view history.
       * @deny (update) Audit logs should generally be immutable (denied here for extra security).
       * @principle Enforces path consistency and ownership for audit logs.
       */
      match /auditTrail/{entryId} {
        allow get, list: if isOwner(resource.data.loanOwnerUserId);
        allow create: if isSignedIn() && request.resource.data.loanOwnerUserId == request.auth.uid;
        allow update: if false; // Audit logs should not be modified
        allow delete: if isExistingOwner(resource.data.loanOwnerUserId);
      }
    }
  }
}